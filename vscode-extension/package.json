{
  "name": "ignite-vscode",
  "displayName": "Ignite",
  "description": "Run Ignite's compliance/security pipeline against the open workspace folder — findings in the Problems panel, no separate web UI required.",
  "version": "0.1.0",
  "publisher": "ignite",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nunomcpereira/ignite.git",
    "directory": "vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/nunomcpereira/ignite/issues"
  },
  "homepage": "https://github.com/nunomcpereira/ignite/tree/main/vscode-extension#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ignite.scanWorkspace",
        "title": "Ignite: Scan Workspace — run the full compliance/security pipeline",
        "icon": "$(shield)"
      },
      {
        "command": "ignite.scanChangedFiles",
        "title": "Ignite: Scan Changed Files — full pipeline, findings limited to uncommitted files",
        "icon": "$(diff)"
      },
      {
        "command": "ignite.explainIssue",
        "title": "Ignite: Explain Finding — plain-language explanation via the local LLM"
      },
      {
        "command": "ignite.suggestFixForIssue",
        "title": "Ignite: Suggest Fix — propose (and optionally apply) a one-off code fix for this finding"
      },
      {
        "command": "ignite.showOutput",
        "title": "Ignite: Show Output"
      },
      {
        "command": "ignite.openReviewFile",
        "title": "Ignite: Open Review File"
      },
      {
        "command": "ignite.acknowledgeIssue",
        "title": "Ignite: Open in Review File — jump to this finding's Acknowledge: line"
      },
      {
        "command": "ignite.acknowledgeSelected",
        "title": "Ignite: Acknowledge Selected — write one shared justification for every selected finding",
        "icon": "$(check)"
      },
      {
        "command": "ignite.toggleFindingGrouping",
        "title": "Ignite: Toggle Findings Grouping (Finding / Phase)",
        "icon": "$(list-tree)"
      },
      {
        "command": "ignite.generateFixPr",
        "title": "Ignite: Generate Fix PR — preview AI-suggested fixes for open findings and open a PR",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "ignite.installPrePushHook",
        "title": "Ignite: Install Pre-Push Hook"
      },
      {
        "command": "ignite.refreshToolsStatus",
        "title": "Ignite: Refresh Tools Status — re-probe which scanner tools are installed/enabled",
        "icon": "$(refresh)"
      },
      {
        "command": "ignite.showLicenseCompliance",
        "title": "Ignite: Show License Compliance"
      },
      {
        "command": "ignite.showSbom",
        "title": "Ignite: Show SBOM"
      },
      {
        "command": "ignite.showLocMetrics",
        "title": "Ignite: Show LOC Metrics"
      },
      {
        "command": "ignite.showPosture",
        "title": "Ignite: Show Compliance & Feature Posture"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "ignite.acknowledgeIssue",
          "when": "false"
        },
        {
          "command": "ignite.acknowledgeSelected",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "ignite.scanWorkspace",
          "when": "view == igniteFindings",
          "group": "navigation"
        },
        {
          "command": "ignite.scanChangedFiles",
          "when": "view == igniteFindings",
          "group": "navigation"
        },
        {
          "command": "ignite.toggleFindingGrouping",
          "when": "view == igniteFindings",
          "group": "navigation"
        },
        {
          "command": "ignite.generateFixPr",
          "when": "view == igniteFindings",
          "group": "navigation"
        },
        {
          "command": "ignite.refreshToolsStatus",
          "when": "view == igniteToolsStatus",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ignite.acknowledgeSelected",
          "when": "view == igniteFindings && (viewItem == igniteFindingGroup || viewItem == igniteUnresolvedIssue)",
          "group": "inline"
        },
        {
          "command": "ignite.acknowledgeIssue",
          "when": "view == igniteFindings && viewItem == igniteUnresolvedIssue",
          "group": "1_ignite"
        },
        {
          "command": "ignite.explainIssue",
          "when": "view == igniteFindings && viewItem =~ /^ignite(Unresolved)?Issue$/",
          "group": "1_ignite"
        },
        {
          "command": "ignite.suggestFixForIssue",
          "when": "view == igniteFindings && viewItem =~ /^ignite(Unresolved)?Issue$/",
          "group": "1_ignite"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ignite",
          "title": "Ignite",
          "icon": "resources/ignite.svg"
        }
      ]
    },
    "views": {
      "ignite": [
        {
          "id": "igniteFindings",
          "name": "Findings"
        },
        {
          "id": "igniteToolsStatus",
          "name": "Tools Status"
        }
      ]
    },
    "configuration": {
      "title": "Ignite",
      "properties": {
        "ignite.baseUrl": {
          "type": "string",
          "default": "http://localhost:51337",
          "description": "Base URL of a running Ignite server (npm start in the ignite repo). Matches IGNITE_BASE_URL."
        },
        "ignite.runLocalCi": {
          "type": "boolean",
          "default": false,
          "description": "Run Phase 5 org governance CI (act + Docker) as part of a scan. Off by default in the extension — it's the slowest phase and needs Docker."
        },
        "ignite.showOverriddenIssues": {
          "type": "boolean",
          "default": false,
          "description": "Show issues already acknowledged in .ignite/acknowledgments.md as dimmed diagnostics instead of hiding them."
        },
        "ignite.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional `ignite_...` API key (mint one with `ignite create-api-key <email>` on the server), sent as `Authorization: Bearer`. Most scans work fine without it, but it's needed for **Generate Fix PR** to open the PR under your own connected GitHub account instead of the server's fallback token."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "test": "tsc -p ./ && node --test dist/*.test.js"
  },
  "devDependencies": {
    "@types/he": "^1.2.3",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "he": "^1.2.0"
  }
}
