{
  "name": "ignite",
  "version": "1.0.0",
  "description": "Ignite — onboarding gatekeeper that scans uploaded projects for security/framework violations and runs org governance CI locally before pushing to GitHub",
  "main": "server.js",
  "bin": {
    "ignite": "bin/ignite.js"
  },
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "guidelines:mcp": "node mcp-server.js",
    "guidelines:mcp:http": "MCP_TRANSPORT=http node mcp-server.js",
    "guidelines:api": "node guidelines-api.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:e2e": "playwright test",
    "release:sign": "node scripts/sign-release.js",
    "release:verify": "node scripts/verify-release.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "node-stream-zip": "^1.15.0",
    "nodemailer": "^9.0.3",
    "openid-client": "^5.7.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0"
  }
}
