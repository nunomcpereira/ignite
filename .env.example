# Copy to .env and fill in what you need. Loaded automatically on server
# start (see `require('dotenv').config()` in server.js). Anything left unset
# falls back to config.json/config.example.json defaults.

PORT=51337
# Streamable HTTP MCP server auto-started alongside the main server (see
# mcp.autoStart in config.json) - MCP_HTTP_PORT overrides where it listens.
MCP_HTTP_PORT=51338
# Set to false to stop the server auto-starting the HTTP MCP server
# MCP_AUTOSTART=true

# Where config.json is read from: IGNITE_CONFIG_DIR/config.json by default
# (cwd when unset); IGNITE_CONFIG_PATH points at the file directly.
# IGNITE_CONFIG_DIR=
# IGNITE_CONFIG_PATH=
# Server data dir (retained sources, pending effectivations, CodeQL dbs)
# IGNITE_DATA_DIR=~/.ignite
# Per-check timeout for every Phase 4 check, in seconds
# IGNITE_PHASE4_CHECK_TIMEOUT_SECS=1200

# ---------------------------------------------------------------------------
# LLM deep-scan / AI insight / issue-explain backend
# ---------------------------------------------------------------------------
# Which backend phase 4's deep-scan (and the AI insight/explain features) call:
#   local     - a local, OpenAI-Chat-Completions-compatible server (llama.cpp, etc.)
#   openai    - the real OpenAI API (or any OpenAI-compatible proxy/gateway)
#   anthropic - the real Anthropic Messages API (or any Anthropic-compatible proxy/gateway)
#   azure-foundry - Azure AI Foundry (formerly Azure OpenAI Service)
LLM_PROVIDER=local

# --- local provider ---
LLM_SCAN_URL=http://localhost:8050
LLM_SCAN_MODEL=default
# warn: flag issues but let the pipeline continue; block: treat as gating
LLM_SCAN_MODE=warn
# Comma-separated origins allowed for LLM_SCAN_URL, beyond its own default origin
LLM_SCAN_TRUSTED_ORIGINS=

# --- openai provider (used only when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Override to point at an OpenAI-compatible gateway/proxy instead of api.openai.com
OPENAI_BASE_URL=https://api.openai.com/v1

# --- anthropic provider (used only when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Override to point at an Anthropic-compatible gateway/proxy instead of api.anthropic.com
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# --- azure-foundry provider (used only when LLM_PROVIDER=azure-foundry) ---
AZURE_FOUNDRY_API_KEY=
# Resource endpoint only, e.g. https://my-resource.openai.azure.com - no
# /openai/deployments/... suffix, that's built from the deployment/api
# version below.
AZURE_FOUNDRY_ENDPOINT=
# Azure Foundry addresses models by deployment name, not model name.
AZURE_FOUNDRY_DEPLOYMENT=
AZURE_FOUNDRY_API_VERSION=2024-10-21

# --- shared deep-scan tuning ---
# Gates only Phase 4's automated deep-scan (Check 3) - the on-demand
# "Explain issue"/"Suggest AI fix" buttons in Ignite Studio keep working
# off the same LLM_PROVIDER/LLM_SCAN_URL connection either way.
LLM_DEEP_SCAN_ENABLED=true
LLM_MAX_FILES=40
# Per-request source budget in characters. Lower = more, smaller, faster
# requests; raise it only if your backend comfortably handles a bigger context.
LLM_CHUNK_CHARS=10000
# warning: quality/encapsulation findings show as warnings; info: informational only
LLM_ADVISORY_LEVEL=info

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
AUTH_MODE=standalone
# OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=
# OIDC_ISSUER=
# GitHub-login mode (AUTH_MODE=github) and Studio's "Connect GitHub" flow
# both read config.json's github.oauth.* by default, which has no per-
# environment value of its own (it's gitignored) - set these to override it
# without editing that file, e.g. so a deployed instance doesn't keep
# redirecting the OAuth callback back to a dev-only http://localhost URL.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=
# GITHUB_OAUTH_SCOPE=
# Test-only: points the GitHub OAuth flow at a local mock instead of github.com
# IGNITE_GITHUB_OAUTH_MOCK_BASE=

# ---------------------------------------------------------------------------
# Notifications (SMTP)
# ---------------------------------------------------------------------------
SMTP_PASS=
# Aliases for SMTP_PASS, checked in this order: NOTIFICATIONS_SMTP_PASS, SMTP_PASS, SMTP_PASSWORD
# NOTIFICATIONS_SMTP_PASS=
# SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# Org daily security report delivery (also editable from the UI's
# Admin / Integrations dialog, which stores values in ignite.db and wins over these)
# ---------------------------------------------------------------------------
# DAILY_REPORT_ENABLED=false
# DAILY_REPORT_TIME=23:59
# DAILY_REPORT_TO=
# Microsoft Sentinel Logic App / generic HTTPS webhook
# DAILY_REPORT_WEBHOOK_URL=
# optional bearer token
# DAILY_REPORT_WEBHOOK_TOKEN=
# https://<account>.blob.core.windows.net/<container>?<sas>
# DAILY_REPORT_AZURE_BLOB_CONTAINER_URL=

# ---------------------------------------------------------------------------
# Org governance CI (act) / GitHub shipping
# ---------------------------------------------------------------------------
GOVERNANCE_REPO=
GOVERNANCE_WORKFLOW=
ACT_EVENT=pull_request
ACT_TIMEOUT_MIN=30
# 'https' (default) pushes via https://github.com/... authenticated through
# `gh auth git-credential`; 'ssh' pushes via git@github.com:... using
# whatever SSH key/agent is already configured for github.com instead. Repo
# creation/auto-merge/ref-creation always go through the GitHub API (gh api
# with GH_TOKEN) regardless - SSH only replaces the git push transport, not
# API auth, so a connected GitHub account is still required either way.
GITHUB_REMOTE_PROTOCOL=https
# `gh` CLI is a soft dependency for GitHub API calls (repo creation, PR/
# auto-merge/checks, issue filing, cloning) - if it isn't installed, Ignite
# falls back to calling the REST/GraphQL API directly over HTTPS with a
# token. Per-onboarding-request calls already use the connected account's
# own token automatically. Server-level calls with no per-request user
# (governance workflow fetch, scheduled re-check clone/issue-create) have
# no connected-user token to fall back on - set one of these to a personal
# access token (repo scope) to keep those working without gh installed.
# GH_TOKEN=
# GITHUB_TOKEN=

# Shared secret for POST /api/webhooks/github/code-scanning (inbound GHAS-
# parity dismissal sync: a human dismissing/reopening a code-scanning alert
# directly in GitHub's UI is reflected back into Ignite's own issue state).
# Must match the "Secret" configured when registering the webhook on the
# repo/org in GitHub's settings (code_scanning_alert events). Unset (the
# default) makes the endpoint reject every request.
# CODE_SCANNING_INBOUND_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# GitHub Security-tab parity (all on by default): SARIF upload to Code
# Scanning, dismissing GitHub alerts for findings overridden in Ignite,
# Dependency graph snapshots, the PR "Dependency Review" sticky comment and
# inline PR fix suggestions - all pushed from POST /api/pipeline/:jobId/github-check
# ---------------------------------------------------------------------------
# CODE_SCANNING_ENABLED=true
# CODE_SCANNING_SYNC_DISMISSALS=true
# DEPENDENCY_GRAPH_ENABLED=true
# DEPENDENCY_REVIEW_ENABLED=true
# PR_SUGGESTIONS_ENABLED=true

# Inbound GitHub webhooks - each endpoint 404s until its secret is set.
# secret_scanning_alert lifecycle sync (POST /api/webhooks/github/secret-scanning)
# SECRET_SCANNING_INBOUND_WEBHOOK_SECRET=
# Push-protection bypass alerts (POST /api/webhooks/github/push-protection);
# AUTO_FILE_ISSUE also files a GitHub issue per bypass
# PUSH_PROTECTION_INBOUND_WEBHOOK_SECRET=
# PUSH_PROTECTION_AUTO_FILE_ISSUE=false
# Zero-touch enrollment on repository.created/transferred
# (POST /api/webhooks/github/repository-events); the two opt-ins also apply
# the org ignite/gate ruleset and kick off a baseline scan
# REPOSITORY_EVENTS_INBOUND_WEBHOOK_SECRET=
# REPOSITORY_EVENTS_APPLY_ORG_RULESET=false
# REPOSITORY_EVENTS_TRIGGER_BASELINE_SCAN=false

# ---------------------------------------------------------------------------
# Secret scan (gitleaks)
# ---------------------------------------------------------------------------
GITLEAKS_ENABLED=false
GITLEAKS_BINARY=gitleaks
GITLEAKS_CONFIG_PATH=
# Also scan full git history (forced on anyway for non-fast runs)
# GITLEAKS_SCAN_HISTORY=false

# Comma-separated regexes for public keys the secret scan should never flag
# SECRETS_KNOWN_PUBLIC_KEY_PATTERNS=
# Comma-separated path prefixes excluded from security scanning
# SECURITY_EXCLUDE_PATHS=
# Ping the issuing provider (GitHub, Slack, Stripe, AWS, ...) to tell a live
# leaked token from a dead one. Sends found credentials to third-party APIs,
# so it's off by default.
# SECRET_VERIFICATION_ENABLED=false

# ---------------------------------------------------------------------------
# IaC/container misconfiguration scan (trivy) - on by default, soft-falls
# back to a built-in Dockerfile heuristic check if trivy isn't installed
# ---------------------------------------------------------------------------
TRIVY_ENABLED=true
TRIVY_BINARY=trivy
# Container-image CVE scan: docker build per Dockerfile + trivy image. Off by
# default (can take minutes per image)
# TRIVY_IMAGE_ENABLED=false
# TRIVY_IMAGE_SEVERITY=HIGH,CRITICAL
# TRIVY_IMAGE_BUILD_TIMEOUT_MS=1800000

# ---------------------------------------------------------------------------
# Supplemental IaC misconfig scan (checkov) - on by default, merges into
# the trivy/fallback IaC findings when installed
# ---------------------------------------------------------------------------
CHECKOV_ENABLED=true
CHECKOV_BINARY=checkov

# ---------------------------------------------------------------------------
# Supplemental Dockerfile-only lint (hadolint) - on by default, merges into
# the trivy/fallback IaC findings when installed
# ---------------------------------------------------------------------------
HADOLINT_ENABLED=true
HADOLINT_BINARY=hadolint

# ---------------------------------------------------------------------------
# SBOM generation (syft) - on by default, attaches a CycloneDX SBOM as a
# downloadable project document; falls back to a minimal manifest-derived
# component list when missing
# ---------------------------------------------------------------------------
SYFT_ENABLED=true
SYFT_BINARY=syft

# ---------------------------------------------------------------------------
# Base-image signature/provenance verification (cosign) - on by default
# (makes a real network call per unique base image); flags unsigned images
# as advisory warnings, never blocking
# ---------------------------------------------------------------------------
COSIGN_ENABLED=true
COSIGN_BINARY=cosign
COSIGN_IDENTITY_REGEXP=.*
COSIGN_ISSUER_REGEXP=.*
# How long a base image's verification result is cached, in seconds
# COSIGN_CACHE_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Semantic SAST (semgrep) - on by default, no built-in fallback when missing
# ---------------------------------------------------------------------------
SEMGREP_ENABLED=true
SEMGREP_BINARY=semgrep
SEMGREP_CONFIG=p/security-audit

# ---------------------------------------------------------------------------
# PII/GDPR data-flow SAST (bearer) - on by default, no built-in fallback
# ---------------------------------------------------------------------------
BEARER_ENABLED=true
BEARER_BINARY=bearer

# ---------------------------------------------------------------------------
# Malicious-dependency heuristic scan (guarddog, npm/PyPI) - on by default
# (downloads and inspects every dependency's real package contents, slower
# and heavier than the rest of Phase 4 - set to false to opt out in
# environments with many manifest dependencies); no built-in fallback
# ---------------------------------------------------------------------------
GUARDDOG_ENABLED=true
GUARDDOG_BINARY=guarddog

# ---------------------------------------------------------------------------
# Malicious ML model artifact scan (picklescan) - on by default. Flags
# unsafe pickle global imports in .pkl/.pickle/.pt/.pth/.ckpt/.bin files -
# a poisoned model weight file executes arbitrary code on load. No built-in
# fallback.
# ---------------------------------------------------------------------------
PICKLESCAN_ENABLED=true
PICKLESCAN_BINARY=picklescan

# ---------------------------------------------------------------------------
# AI package-hallucination / slopsquat detection - built-in, no external
# tool. Checks each manifest dependency name against its ecosystem's real
# public registry (npm/PyPI/crates.io); a 404 is possibly an AI-invented
# name vulnerable to squatting. Always advisory - never blocks a run.
# ---------------------------------------------------------------------------
PACKAGE_HALLUCINATION_ENABLED=true

# ---------------------------------------------------------------------------
# GitHub Actions workflow security (zizmor) - Trail of Bits' purpose-built
# GHA auditor: pwn-request patterns (pull_request_target checking out and
# running PR-head code with secrets access), script injection via untrusted
# ${{ }} expansions in run: steps, excessive permissions:, unpinned actions,
# and more. Skipped entirely (no invocation) when a repo has no
# .github/workflows/*.yml. No built-in fallback - this needs zizmor's real
# workflow-expression parser, not a regex approximation.
# ---------------------------------------------------------------------------
ZIZMOR_ENABLED=true
ZIZMOR_BINARY=zizmor

# ---------------------------------------------------------------------------
# Cross-file static analysis (CodeQL) - on by default, same as the rest of
# Phase 4. Measured for real against Ignite's own codebase: only ~3s added
# to Phase 4's total wall time, since its database build finishes inside
# whichever other check is already the long pole (typically Bearer). Set to
# false to opt out - e.g. if Bearer/Semgrep/GuardDog are disabled or fast
# enough that CodeQL's own cost would become visible. No built-in fallback.
# ---------------------------------------------------------------------------
CODEQL_ENABLED=true
CODEQL_BINARY=codeql
# Comma-separated CodeQL language ids to scan (subset of: javascript, python, java, go)
CODEQL_LANGUAGES=javascript,python,java,go
# JSON object overriding/extending the default per-language query suite map, e.g.
# CODEQL_QUERY_SUITES={"javascript":"codeql/javascript-queries:codeql-suites/javascript-security-and-quality.qls"}
#CODEQL_QUERY_SUITES=
# 0 = let codeql pick its own defaults for threads/RAM
CODEQL_THREADS=0
CODEQL_RAM_MB=0
# Per-language database create/analyze timeout, in milliseconds
CODEQL_TIMEOUT_MS=1200000
# Pinned query suites should be re-reviewed every N days; the server warns at
# startup when LAST_REVIEWED_AT (YYYY-MM-DD) is unset or older than that
# CODEQL_REVIEW_CADENCE_DAYS=90
# CODEQL_LAST_REVIEWED_AT=

# ---------------------------------------------------------------------------
# Code duplication (jscpd, off by default) and LOC metrics (gocloc, on by
# default) - no built-in fallback for either
# ---------------------------------------------------------------------------
JSCPD_ENABLED=false
JSCPD_BINARY=jscpd
JSCPD_MIN_LINES=5
JSCPD_MIN_TOKENS=50
# Comma-separated jscpd --ignore globs. Default excludes generated/design
# exports (docs/**), test files (fixture/setup duplication across test
# suites is standard practice, not maintenance risk), and package-manager
# lockfiles (machine-written, never hand-edited).
JSCPD_IGNORE=docs/**,**/*.test.*,**/*.spec.*,**/__tests__/**,**/package-lock.json,**/yarn.lock,**/pnpm-lock.yaml,**/Gemfile.lock,**/poetry.lock,**/Cargo.lock,**/go.sum,**/composer.lock
GOCLOC_ENABLED=true
GOCLOC_BINARY=gocloc
# Built-in oversized-file check
# FILE_SIZE_ENABLED=true
# FILE_SIZE_MAX_LINES=1000

# ---------------------------------------------------------------------------
# API schema lint (spectral) - on by default, no built-in fallback. Ruleset
# defaults to the bundled spectral-default-ruleset.yaml (spectral:oas +
# spectral:asyncapi); point SPECTRAL_RULESET at your own for org conventions
# ---------------------------------------------------------------------------
SPECTRAL_ENABLED=true
SPECTRAL_BINARY=spectral
SPECTRAL_RULESET=

# ---------------------------------------------------------------------------
# API breaking-change / shadow-endpoint detection (oasdiff) - on by default,
# no built-in fallback. Diffs each OpenAPI/AsyncAPI file against its own
# previous git revision - only active when there's real git history to diff
# against (a fresh upload with no prior commit contributes nothing here)
# ---------------------------------------------------------------------------
OASDIFF_ENABLED=true
OASDIFF_BINARY=oasdiff

# ---------------------------------------------------------------------------
# Compliance & Feature Posture Engine - detects presence (not vulnerabilities)
# of SSO/RBAC/audit-logging/TLS/backups/encryption/rate-limiting. Fully
# conditioned on Semgrep (security.semgrep's binary, shared): on by default,
# falls back to a built-in regex posture scanner when Semgrep is unavailable
# ---------------------------------------------------------------------------
POSTURE_ENABLED=true
POSTURE_RULESET=

# ---------------------------------------------------------------------------
# EU AI Act document-presence scan - built-in, no external tool. Flags
# whether a risk-management-system doc, Annex IV technical documentation, an
# FRIA, a GPAI training-data summary, or a post-market monitoring plan exists
# anywhere in the repo by filename/path match. Advisory only, never blocks.
# ---------------------------------------------------------------------------
EU_AI_ACT_DOCS_ENABLED=true

# Whether the EU AI Act signals (posture engine's ai-act-* categories +
# the document-presence scan's MISSING categories) surface as addressable,
# overridable issues instead of staying advisory-only in the report
# documents. false = advisory only (default); true = findings, always
# severity 'warning' (heuristic signals never hard-block a run)
EU_AI_ACT_REPORT_AS_FINDINGS=false

# ---------------------------------------------------------------------------
# Built-in codebase-intelligence checks - no external tool, always advisory.
# Boundaries is off by default; preset is one of bulletproof, layered,
# hexagonal, feature-sliced. IGNOREFILE flags an uncommitted .igniteignore.
# ---------------------------------------------------------------------------
# DEAD_CODE_ENABLED=true
# HEALTH_ENABLED=true
# CSS_DEAD_CODE_ENABLED=true
# ARCHITECTURE_BOUNDARIES_ENABLED=false
# ARCHITECTURE_BOUNDARIES_PRESET=
# IGNOREFILE_ENABLED=true

# ---------------------------------------------------------------------------
# Env-var documentation drift - built-in, no external tool. Flags env vars
# the scanned code reads that its .env.example/.env.sample/.env.template
# doesn't list (commented `# VAR=` lines count as listed), and template
# entries nothing references. Advisory only, never blocks.
# ---------------------------------------------------------------------------
ENV_VAR_DRIFT_ENABLED=true

# ---------------------------------------------------------------------------
# POST /api/pipeline/validate-all requires an authenticated caller (session
# or API key) by default - it runs a full pipeline scan and, when overrides
# are submitted, records audit-log entries attributed to whatever email is
# in the request. Set to true only for a headless deployment that can't
# complete the one-time login needed to mint an API key (e.g. an
# offline/air-gapped runner with no path to the auth.mode: "github" OAuth
# flow) - actor attribution then falls back to the request body's own
# `actor` field (unverified). Scoped to this one endpoint only.
# ---------------------------------------------------------------------------
ALLOW_UNAUTHENTICATED_VALIDATE_ALL=false

# ---------------------------------------------------------------------------
# Same bypass, extended to the browser UI's interactive upload endpoint
# (POST /api/pipeline) - but only ever for a simulation (dryRun: true).
# A real provisioning+push through that same endpoint still requires an
# actual session regardless of this flag (Phase 1 fails fast with no
# session-backed GitHub token to push with). When enabled and no session
# is present, the run is attributed to a fixed synthetic actor
# (unauthenticated-simulation@ignite.internal), never a client-supplied
# identity. Default false - an existing deployment's behavior never
# changes silently.
# ---------------------------------------------------------------------------
ALLOW_UNAUTHENTICATED_INTERACTIVE_DRY_RUN=false

# ---------------------------------------------------------------------------
# Same bypass shape, scoped to POST /api/issues/explain and
# POST /api/issues/suggest-fix (Studio's "Explain this issue"/"AI Suggested
# Fix" actions) - both RequireAuth-gate by default because each call spends
# real money against the configured LLM provider's API key with no
# per-caller limit otherwise. Set true only for a single-operator
# local/offline deployment where the GitHub-OAuth login flow is friction
# with no real attribution benefit (no one else can reach the server).
# Default false - a real multi-user deployment should leave this off so LLM
# spend stays attributable.
# ---------------------------------------------------------------------------
ALLOW_UNAUTHENTICATED_AI_ASSIST=false

# ---------------------------------------------------------------------------
# Policy / repo-sweep / reporting tuning
# ---------------------------------------------------------------------------
POLICY_STRICT=false
PR_STATUS_MAX_WARNINGS=
ORG_REPOS_MAX_CONCURRENT_SCANS=2
ORG_REPOS_AUTO_RESCAN_STALE_AFTER_HOURS=24
# Vulnerability SLA: days an open issue may age before it's a breach
# (critical >= score 9, high >= 7, else medium)
# SLA_ENABLED=true
# SLA_CRITICAL_DAYS=7
# SLA_HIGH_DAYS=30
# SLA_MEDIUM_DAYS=90
# Dual-custody: critical overrides need a second approver from this
# comma-separated email list
# OVERRIDE_APPROVAL_ENABLED=false
# OVERRIDE_APPROVAL_APPROVER_EMAILS=
# LLM-drafted justifications for low-risk categories (comma-separated)
# AI_AUTO_JUSTIFY_ENABLED=false
# AI_AUTO_JUSTIFY_CATEGORIES=license-compliance
# SIEM streaming; SINKS is a JSON array of {"url","kind","token"} where kind
# is generic, splunk_hec, datadog or cef
# AUDIT_LOG_ENABLED=false
# AUDIT_LOG_SINKS=[]

# Standalone helpers / clients
# Set to 0 to disable MCP-side async polling; unset or any other value keeps the default (enabled).
IGNITE_MCP_ASYNC=
# How often the MCP onboard_project tool polls an async run, and how long it waits in total
# IGNITE_MCP_POLL_MS=2000
# IGNITE_MCP_MAX_WAIT_SECS=3600
IGNITE_RETENTION_MAX_AGE_DAYS=90

# CLI (`ignite scan` / pre-push hook) and MCP server
# MCP server transport: stdio or http
# MCP_TRANSPORT=stdio
# IGNITE_BASE_URL=http://localhost:51337
# IGNITE_API_KEY=
# IGNITE_REVIEW_FILE=.ignite/acknowledgments.md
# IGNITE_RUN_LOCAL_CI=true
# continue = only errors need an override; stop = warnings need one too
# IGNITE_WARNING_MODE=continue
# IGNITE_FAST_SCAN=false

# Standalone binaries (scheduled-rescan, org-onboard, auto-fix-pr, retention-sweeper, create-api-key)
# IGNITE_SERVER_URL=http://127.0.0.1:51337
# IGNITE_DB_PATH=ignite.db
# IGNITE_SCHEDULED_RESCAN_TIMEOUT_SECS=1800
# off, dry-run or apply: chain auto-fix-pr after a non-clean rescan
# IGNITE_SCHEDULED_RESCAN_AUTO_FIX=off
# Who create-api-key attributes a minted key to
# IGNITE_OPERATOR=
# guidelines-api bind address
# GUIDELINES_API_HOST=127.0.0.1
# GUIDELINES_API_PORT=8090

# docker-compose.yml: host docker group id, so the container can use the Docker socket
# DOCKER_GID=999
