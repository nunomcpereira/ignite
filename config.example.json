{
  "port": 51337,
  "llm": {
    "provider": "local",
    "url": "http://localhost:8050",
    "model": "default",
    "mode": "warn",
    "maxFiles": 40,
    "chunkChars": 10000,
    "openai": {
      "apiKey": "",
      "baseUrl": "https://api.openai.com/v1",
      "model": "gpt-4o-mini"
    },
    "anthropic": {
      "apiKey": "",
      "baseUrl": "https://api.anthropic.com/v1",
      "model": "claude-opus-5"
    },
    "azureFoundry": {
      "apiKey": "",
      "endpoint": "",
      "deployment": "",
      "apiVersion": "2024-10-21"
    }
  },
  "governance": {
    "repo": "ai-governance-poc-2026/devops-governance",
    "workflow": "ai-guardrails-orchestrator.yml",
    "event": "pull_request",
    "timeoutMinutes": 30
  },
  "notifications": {
    "enabled": true,
    "to": "you@example.com",
    "from": "Ignite Gatekeeper <you@example.com>",
    "smtp": {
      "host": "smtp.gmail.com",
      "port": 465,
      "secure": true,
      "user": "you@example.com",
      "caCertPath": "",
      "allowInvalidCerts": false
    }
  },
  "auth": {
    "mode": "standalone",
    "allowSelfRegistration": true,
    "oidc": {
      "issuer": "https://your-idp.example.com",
      "clientId": "ignite",
      "clientSecret": "",
      "redirectUri": "http://localhost:51337/api/auth/oidc/callback",
      "scope": "openid email profile"
    }
  },
  "security": {
    "gitleaks": {
      "enabled": false,
      "binary": "gitleaks",
      "configPath": "",
      "scanHistory": false
    },
    "trivy": {
      "enabled": true,
      "binary": "trivy"
    },
    "trivyImage": {
      "enabled": false
    },
    "checkov": {
      "enabled": true,
      "binary": "checkov"
    },
    "hadolint": {
      "enabled": true,
      "binary": "hadolint"
    },
    "cosign": {
      "enabled": true,
      "binary": "cosign",
      "identityRegexp": ".*",
      "issuerRegexp": ".*"
    },
    "semgrep": {
      "enabled": true,
      "binary": "semgrep",
      "config": "p/security-audit"
    },
    "bearer": {
      "enabled": true,
      "binary": "bearer"
    },
    "guarddog": {
      "enabled": true,
      "binary": "guarddog"
    },
    "picklescan": {
      "enabled": true,
      "binary": "picklescan",
      "extensions": [".pkl", ".pickle", ".pt", ".pth", ".ckpt", ".bin"]
    },
    "packageHallucination": {
      "enabled": true
    },
    "zizmor": {
      "enabled": true,
      "binary": "zizmor"
    },
    "dependencyGraph": {
      "enabled": true
    },
    "codeScanning": {
      "enabled": true,
      "syncDismissals": true
    },
    "dependencyReview": {
      "enabled": true
    },
    "prSuggestions": {
      "enabled": true
    },
    "secretVerification": {
      "enabled": false,
      "timeoutMs": 5000
    },
    "pushProtection": {
      "inboundWebhookSecret": null,
      "autoFileIssue": false
    },
    "secretScanning": {
      "inboundWebhookSecret": null
    },
    "repositoryEvents": {
      "inboundWebhookSecret": null,
      "applyOrgRuleset": false,
      "triggerBaselineScan": false
    },
    "overrideApproval": {
      "enabled": false,
      "approverEmails": []
    },
    "allowUnauthenticatedValidateAll": false,
    "allowUnauthenticatedInteractiveDryRun": false,
    "codeql": {
      "enabled": true,
      "binary": "codeql",
      "languages": ["javascript", "python", "java", "go"],
      "querySuites": {
        "javascript": "codeql/javascript-queries@2.4.4:codeql-suites/javascript-security-extended.qls",
        "python": "codeql/python-queries@1.8.9:codeql-suites/python-security-extended.qls",
        "java": "codeql/java-queries@1.11.9:codeql-suites/java-security-extended.qls",
        "go": "codeql/go-queries@1.6.9:codeql-suites/go-security-extended.qls"
      },
      "threads": 0,
      "ramMB": 0,
      "timeoutMs": 1200000,
      "reviewCadenceDays": 90,
      "lastReviewedAt": "2026-09-02"
    }
  },
  "compliance": {
    "posture": {
      "enabled": true,
      "ruleset": ""
    },
    "euAiActDocuments": {
      "enabled": true
    },
    "euAiAct": {
      "reportAsFindings": false
    }
  },
  "metrics": {
    "jscpd": {
      "enabled": false,
      "binary": "jscpd",
      "minLines": 15,
      "minTokens": 150,
      "ignorePatterns": [
        "docs/**", "**/*.test.*", "**/*.spec.*", "**/__tests__/**",
        "**/package-lock.json", "**/yarn.lock", "**/pnpm-lock.yaml",
        "**/Gemfile.lock", "**/poetry.lock", "**/Cargo.lock", "**/go.sum",
        "**/composer.lock"
      ]
    },
    "gocloc": {
      "enabled": true,
      "binary": "gocloc"
    }
  },
  "api": {
    "spectral": {
      "enabled": true,
      "binary": "spectral",
      "ruleset": ""
    },
    "oasdiff": {
      "enabled": true,
      "binary": "oasdiff"
    }
  },
  "sbom": {
    "syft": {
      "enabled": true,
      "binary": "syft"
    }
  },
  "aiAutoJustify": {
    "enabled": false,
    "categories": ["license-compliance"],
    "maxFindingsPerRequest": 50
  },
  "sla": {
    "enabled": true,
    "criticalDays": 7,
    "highDays": 30,
    "mediumDays": 90
  },
  "blame": {
    "enabled": true,
    "maxRemoteFilesPerScan": 300,
    "minRateLimitRemaining": 1000
  },
  "policy": {
    "strict": false
  },
  "orgRepos": {
    "autoRescanStaleAfterHours": 24
  },
  "scanQueue": {
    "maxConcurrent": 3,
    "userReservedSlots": 1
  },
  "dailyReport": {
    "enabled": false,
    "time": "23:59",
    "to": "",
    "webhookUrl": "",
    "webhookToken": "",
    "azureBlobContainerUrl": ""
  },
  "orgReports": {
    "example-org": { "enabled": true, "cron": "0 8 * * MON", "recipients": "admins", "to": ["security-team@example.com"] },
    "sap-*": { "enabled": true, "cron": "0 7 * * 1-5", "recipients": "fixed", "to": ["sap-integration-dl@example.com"] }
  },
  "auditLog": {
    "enabled": false,
    "sinks": [
      { "url": "https://http-intake.logs.datadoghq.com/v1/input", "kind": "datadog", "token": "" }
    ]
  },
  "phases": [
    { "id": 2, "enabled": true },
    { "id": 5, "enabled": false, "title": "Org Governance CI (disabled at this org)" }
  ],
  "mcp": {
    "autoStart": true,
    "httpPort": 51338
  },
  "ignoreRules": {
    "example-org": {
      "*": [
        {
          "filePatterns": ["\\.txt$"],
          "linePatterns": ["SAP_IDOC_REC_Credential_Name=(.*)"],
          "categories": ["secret"],
          "reason": "SAP IDoc credential *names* (logical destination ids), not secrets"
        }
      ],
      "sap-*": [
        {
          "filePatterns": ["^Preparation Steps/.*\\.(txt|properties)$"],
          "linePatterns": ["_Credential_Name=", "^\\s*#"],
          "categories": ["secret"],
          "reason": "Every sap-* repo: credential alias names and commented lines in IDoc prep files"
        }
      ],
      "payments-api": [
        {
          "filePatterns": ["^src/test/resources/fixtures/"],
          "reason": "Whole fixtures folder: fake keys/cards used only by unit tests (all categories)"
        }
      ]
    },
    "*": {
      "*": [
        {
          "filePatterns": ["(^|/)docs/.*\\.md$"],
          "linePatterns": ["(?i)example|placeholder|<your-.*>"],
          "categories": ["secret"],
          "reason": "Every org and repo: placeholder credentials in markdown docs"
        }
      ]
    }
  }
}
