{
  "port": 3000,
  "llm": {
    "provider": "local",
    "url": "http://localhost:8050",
    "model": "default",
    "mode": "warn",
    "maxFiles": 40,
    "chunkChars": 10000,
    "openai": {
      "apiKey": "",
      "baseUrl": "https://api.openai.com/v1",
      "model": "gpt-4o-mini"
    }
  },
  "github": {
    "orgs": "ai-governance-poc-2026",
    "bootstrapBranch": "ignite",
    "oauth": {
      "clientId": "",
      "clientSecret": "",
      "redirectUri": "http://localhost:3000/api/auth/github/callback",
      "scope": "repo"
    }
  },
  "governance": {
    "repo": "ai-governance-poc-2026/devops-governance",
    "workflow": "ai-guardrails-orchestrator.yml",
    "event": "pull_request",
    "timeoutMinutes": 30
  },
  "notifications": {
    "enabled": true,
    "to": "you@example.com",
    "from": "Ignite Gatekeeper <you@example.com>",
    "smtp": {
      "host": "smtp.gmail.com",
      "port": 465,
      "secure": true,
      "user": "you@example.com"
    }
  },
  "auth": {
    "mode": "standalone",
    "allowSelfRegistration": true,
    "oidc": {
      "issuer": "https://your-idp.example.com",
      "clientId": "ignite",
      "clientSecret": "",
      "redirectUri": "http://localhost:3000/api/auth/oidc/callback",
      "scope": "openid email profile"
    }
  },
  "security": {
    "gitleaks": {
      "enabled": false,
      "binary": "gitleaks",
      "configPath": ""
    }
  },
  "phases": [
    { "id": 2, "enabled": true },
    { "id": 5, "enabled": false, "title": "Org Governance CI (disabled at this org)" }
  ]
}
