{
  "port": 3000,
  "llm": {
    "provider": "local",
    "url": "http://localhost:8050",
    "model": "default",
    "mode": "warn",
    "maxFiles": 40,
    "chunkChars": 10000,
    "openai": {
      "apiKey": "",
      "baseUrl": "https://api.openai.com/v1",
      "model": "gpt-4o-mini"
    }
  },
  "github": {
    "orgs": "ai-governance-poc-2026",
    "bootstrapBranch": "ignite",
    "remoteProtocol": "https",
    "oauth": {
      "clientId": "",
      "clientSecret": "",
      "redirectUri": "http://localhost:3000/api/auth/github/callback",
      "scope": "repo"
    }
  },
  "governance": {
    "repo": "ai-governance-poc-2026/devops-governance",
    "workflow": "ai-guardrails-orchestrator.yml",
    "event": "pull_request",
    "timeoutMinutes": 30
  },
  "notifications": {
    "enabled": true,
    "to": "you@example.com",
    "from": "Ignite Gatekeeper <you@example.com>",
    "smtp": {
      "host": "smtp.gmail.com",
      "port": 465,
      "secure": true,
      "user": "you@example.com"
    }
  },
  "auth": {
    "mode": "standalone",
    "allowSelfRegistration": true,
    "oidc": {
      "issuer": "https://your-idp.example.com",
      "clientId": "ignite",
      "clientSecret": "",
      "redirectUri": "http://localhost:3000/api/auth/oidc/callback",
      "scope": "openid email profile"
    }
  },
  "security": {
    "gitleaks": {
      "enabled": false,
      "binary": "gitleaks",
      "configPath": ""
    },
    "trivy": {
      "enabled": true,
      "binary": "trivy"
    },
    "checkov": {
      "enabled": true,
      "binary": "checkov"
    },
    "hadolint": {
      "enabled": true,
      "binary": "hadolint"
    },
    "cosign": {
      "enabled": true,
      "binary": "cosign",
      "identityRegexp": ".*",
      "issuerRegexp": ".*"
    },
    "semgrep": {
      "enabled": true,
      "binary": "semgrep",
      "config": "p/security-audit"
    },
    "bearer": {
      "enabled": true,
      "binary": "bearer"
    },
    "guarddog": {
      "enabled": true,
      "binary": "guarddog"
    }
  },
  "compliance": {
    "posture": {
      "enabled": true,
      "ruleset": ""
    }
  },
  "metrics": {
    "jscpd": {
      "enabled": false,
      "binary": "jscpd",
      "minLines": 5,
      "minTokens": 50,
      "ignorePatterns": [
        "docs/**", "**/*.test.*", "**/*.spec.*", "**/__tests__/**",
        "**/package-lock.json", "**/yarn.lock", "**/pnpm-lock.yaml",
        "**/Gemfile.lock", "**/poetry.lock", "**/Cargo.lock", "**/go.sum",
        "**/composer.lock"
      ]
    },
    "gocloc": {
      "enabled": true,
      "binary": "gocloc"
    }
  },
  "api": {
    "spectral": {
      "enabled": true,
      "binary": "spectral",
      "ruleset": ""
    }
  },
  "sbom": {
    "syft": {
      "enabled": true,
      "binary": "syft"
    }
  },
  "phases": [
    { "id": 2, "enabled": true },
    { "id": 5, "enabled": false, "title": "Org Governance CI (disabled at this org)" }
  ],
  "mcp": {
    "autoStart": true,
    "httpPort": 3001
  }
}
